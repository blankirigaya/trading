APP_ENV=development
APP_MODE=LIVE_SHADOW
DATABASE_URL=postgresql+psycopg://ai_trader:ai_trader@localhost:5432/ai_trader
REDIS_URL=

# Market data provider: fyers (default) or upstox. FYERS is market data only.
MARKET_PROVIDER=fyers

# FYERS credentials (market data). Never logged.
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=
FYERS_API_BASE_URL=https://api-t1.fyers.in
FYERS_DATA_WS_URL=wss://socket.fyers.in/hsm/v1-5/prod
FYERS_FEED_MODE=symbolUpdate

# Paper execution account
SHADOW_INITIAL_CAPITAL_INR=100000
SHADOW_SYMBOLS=NSE:INFY-EQ
PAPER_INITIAL_CAPITAL=100000
# Intraday (MIS-style) margin: a BUY blocks value / multiple cash instead of
# full notional. P&L stays on full notional. 1 = delivery-style blocking.
PAPER_MARGIN_MULTIPLE=5

# Auto-classified AI review universe: UNIVERSE_SIZE symbols chosen from the
# built-in master list by live price. cheap = under the cap, expensive = at or
# above it, mixed = half and half. The UI switch persists and overrides this.
UNIVERSE_MODE=cheap
UNIVERSE_SIZE=100
UNIVERSE_CHEAP_MAX_PRICE_INR=200

# Zerodha equity-intraday charges on every paper fill (estimates, not a contract
# note). Defaults in code match this schedule; set the master switch to false to
# return to free fills.
PAPER_CHARGES_ENABLED=true
PAPER_BROKERAGE_PCT=0.0003
PAPER_BROKERAGE_CAP_INR=20
PAPER_STT_SELL_PCT=0.00025
PAPER_EXCHANGE_TXN_PCT=0.0000297
PAPER_SEBI_PCT=0.000001
PAPER_STAMP_DUTY_BUY_PCT=0.00003
PAPER_GST_PCT=0.18

# Disabled live-execution architecture. Do not enable without exchange/broker
# approvals, verified account sync, and a separate live-trading review.
EXECUTION_BROKER=paper
LIVE_TRADING_APPROVED=false
LIVE_ALLOWED_SYMBOLS=["NSE:INFY-EQ"]
LIVE_MAX_ORDER_VALUE_INR=2000
LIVE_MAX_POSITION_VALUE_INR=5000
LIVE_MAX_DAILY_LOSS_INR=500
LIVE_TRADING_START_IST=09:20
LIVE_TRADING_END_IST=15:15
LIVE_BROKER_TIMEOUT_SECONDS=15

# Machine B (AI node): OpenAI-compatible HTTP endpoint on a trusted LAN or VPN.
# The trading node is a network client only. It never installs or runs a model.
AI_PROVIDER=remote_openai_compatible
AI_BASE_URL=http://AI_MACHINE_IP:8080/v1
AI_MODEL=<server-model-id>
AI_API_KEY=
AI_TIMEOUT_SECONDS=120
AI_MAX_CONCURRENT_REQUESTS=1
AI_SCHEMA_MAX_RETRIES=2

# Amazon Bedrock AI node: Bedrock Runtime Converse API. Set AI_PROVIDER=bedrock to use
# it instead of the OpenAI-compatible AI node. Credentials must come from the standard
# AWS provider chain (for example, an IAM role or temporary session credentials).
AI_PROVIDER=bedrock
BEDROCK_REGION=ap-south-1
# AWS_REGION is also honored when BEDROCK_REGION is empty.
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
BEDROCK_MAX_INPUT_TOKENS=32000
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0
BEDROCK_TIMEOUT_SECONDS=30
BEDROCK_MAX_RETRIES=2
BEDROCK_RETRY_BASE_SECONDS=0.5
BEDROCK_RETRY_MAX_SECONDS=8.0
# Optional inference-cost accounting and budget enforcement. Enter the model-specific
# rates from AWS pricing before uncommenting these values.
# BEDROCK_INPUT_USD_PER_MILLION_TOKENS=
# BEDROCK_OUTPUT_USD_PER_MILLION_TOKENS=
# BEDROCK_MAX_ESTIMATED_USD_PER_REQUEST=
# Optional cheap model for routine cadence reviews (empty falls back to
# BEDROCK_MODEL_ID). Example: Nova Micro via APAC inference profile.
# BEDROCK_CADENCE_MODEL_ID=apac.amazon.nova-micro-v1:0
# BEDROCK_CADENCE_INPUT_USD_PER_MILLION_TOKENS=0.035
# BEDROCK_CADENCE_OUTPUT_USD_PER_MILLION_TOKENS=0.14

# TypeSafe AI Jev critic
JEV_ENABLED=true
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_FAILURE_MODE=FAIL_CLOSED

# Upstox (retained for future use; not in the active FYERS_SHADOW path)
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_BASE_URL=https://api.upstox.com
UPSTOX_ORDER_BASE_URL=https://api-hft.upstox.com

# Parallel reviewer shards. 1 preserves the legacy single reviewer over the
# whole watchlist. Higher values split symbols round-robin across independent
# reviewers, each with its own slice of paper capital (even split).
AI_REVIEW_SHARDS=1

# Daily Bedrock spend cap in USD. When set (and per-model rates are configured
# so spend is measurable), cadence and news reviews pause for the rest of the
# IST trading day once estimated spend crosses it. Paper positions stay open;
# the 15:10 square-off still runs.
AI_MAX_DAILY_SPEND_USD=10

PORTFOLIO_REVIEW_INTERVAL_SECONDS=60

# Continuous ingestion. News is context only: it can request a portfolio review but can
# never place an order. Analysis uses the same remote AI endpoint as everything else.
# A shadow session starts and stops news ingestion automatically; `news poll` and
# `news analyze` are diagnostics only and are NOT needed during trading.
NEWS_ENABLED=true
# Kill switches for the news pipeline and the Sonnet lever. All persisted;
# UI toggles override these defaults at runtime without a restart.
TIER1_NEWS_ENABLED=true
NEWS_ANALYSIS_ENABLED=true
SONNET_ESCALATION_ENABLED=true
AI_MAX_SONNET_ESCALATIONS_PER_DAY=20
NEWS_POLL_INTERVAL_SECONDS=900

# Per-source cadence. Official exchange filings are polled faster than regulators.
NSE_POLL_SECONDS=5
BSE_POLL_SECONDS=5
FINANCIAL_NEWS_POLL_SECONDS=10
RBI_POLL_SECONDS=30
SEBI_POLL_SECONDS=30

# Bounded work. The queue waits rather than dropping news; the semaphore serialises
# requests to the single remote model server.
NEWS_AI_MAX_CONCURRENT_REQUESTS=1
NEWS_AI_MAX_RETRIES=1
NEWS_QUEUE_CAPACITY=200

# A full queue blocks the news feed rather than discarding a filing. Only news tasks can
# ever be slowed by this; the FYERS market task is never blocked.
NEWS_ERROR_BACKOFF_INITIAL_SECONDS=2
NEWS_ERROR_BACKOFF_MAX_SECONDS=300
NEWS_DEGRADED_AFTER_FAILURES=2
NEWS_OFFLINE_AFTER_FAILURES=5

# News naming a currently held symbol triggers a review even when the analyst did not
# ask for one, so an open position can be re-examined on new information.
NEWS_REVIEW_HELD_POSITIONS=true

NEWS_HEADLINE_SIMILARITY_THRESHOLD=0.6
NEWS_MAX_ITEMS_PER_POLL=40
NEWS_DOCUMENTS_ENABLED=true
NEWS_DOCUMENT_STORAGE=data/raw/news_documents
NEWS_EXCERPT_CHARS=600
# Only documents on these hosts are downloaded. A leading "www." is ignored when
# matching, so listing the bare registrable domain is enough.
NEWS_DOCUMENT_ALLOWED_HOSTS=nsearchives.nseindia.com,nseindia.com,rbi.org.in,website.rbi.org.in,rbidocs.rbi.org.in,sebi.gov.in,bseindia.com,pii.bseindia.com

# Hard execution isolation. FYERS order APIs are never called.
LIVE_ORDER_EXECUTION=false
TRADING_ENABLED=false
MAX_AI_CAPITAL_INR=50000
MAX_GROSS_EXPOSURE_INR=50000
MAX_DAILY_LOSS_INR=5000
MAX_SINGLE_POSITION_INR=25000
MAX_OPEN_POSITIONS=5
# Default for the UI "capital cap" toggle. When true, the AI sizes positions
# within paper cash instead of the fixed MAX_* money caps. A persisted UI
# switch overrides this value across restarts.
CAPITAL_CAP_DISABLED=false
# Default for the UI "position cap" toggle. When true, the AI decides how many
# symbols to hold instead of the fixed MAX_OPEN_POSITIONS cap. A persisted UI
# switch overrides this value across restarts.
POSITION_COUNT_CAP_DISABLED=false
MAX_ORDERS_PER_MINUTE=10
ALLOWED_EXCHANGES=NSE
ALLOWED_SEGMENTS=EQ
